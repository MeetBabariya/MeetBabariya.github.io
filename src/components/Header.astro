---
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#record', label: 'Record' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header" transition:persist>
  <div class="container bar">
    <a href="/" class="wordmark">
      <span class="wm-name">Meet Babariya</span>
      <span class="wm-role mono" aria-hidden="true">
        <span data-only="ai">AI Engineer</span><span data-only="quant">Quant</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href} class="nav-link">{n.label}</a>)}
    </nav>

    <div class="controls">
      <div class="lens mono" role="radiogroup" aria-label="Portfolio lens">
        <button role="radio" data-set-lens="ai" aria-checked="true">AI</button>
        <button role="radio" data-set-lens="quant" aria-checked="false">Quant</button>
        <span class="lens-thumb" aria-hidden="true"></span>
      </div>
      <button class="icon" data-theme-toggle aria-label="Toggle colour theme">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path></svg>
      </button>
      <a class="btn btn--solid cta" href="/#contact">Contact</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-med);
  }
  :global(html.scrolled) .site-header { border-bottom-color: var(--rule); }
  .bar { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { display: flex; align-items: baseline; gap: 10px; white-space: nowrap; }
  .wm-name { font-weight: 560; letter-spacing: -0.025em; font-size: 15.5px; }
  .wm-role { font-size: 11.5px; color: var(--fg-3); letter-spacing: 0.02em; }
  .nav { display: flex; gap: 28px; }
  .nav-link { font-size: 14px; color: var(--fg-2); transition: color var(--t-fast); }
  .nav-link:hover { color: var(--fg); }
  .controls { display: flex; align-items: center; gap: 8px; }

  .lens {
    position: relative; display: grid; grid-template-columns: 1fr 1fr;
    height: 32px; padding: 3px; border: 1px solid var(--rule-2); border-radius: 999px;
  }
  .lens button {
    position: relative; z-index: 1; padding: 0 12px; font-size: 11.5px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--fg-3); border-radius: 999px; transition: color var(--t-med) var(--ease);
  }
  .lens button[aria-checked='true'] { color: var(--accent-ink); }
  .lens-thumb {
    position: absolute; inset: 3px auto 3px 3px; width: calc(50% - 3px); border-radius: 999px;
    background: var(--accent); transition: transform var(--t-med) var(--ease), background var(--t-med);
  }
  :global(html[data-lens='quant']) .lens-thumb { transform: translateX(100%); }

  .icon { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; color: var(--fg-2); border: 1px solid var(--rule-2); transition: color var(--t-fast), border-color var(--t-fast); }
  .icon:hover { color: var(--fg); border-color: var(--fg-3); }
  .icon svg { width: 14px; height: 14px; transition: transform var(--t-med) var(--ease); }
  :global(html[data-theme='light']) .icon svg { transform: rotate(180deg); }
  .cta { height: 32px; padding: 0 14px; font-size: 13px; }

  @media (max-width: 900px) { .nav { display: none; } }
  @media (max-width: 520px) {
    .wm-role, .cta { display: none; }
    .bar { gap: 12px; }
  }
</style>
