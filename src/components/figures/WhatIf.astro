---
import './ichart.css';
---

<div class="ichart" data-whatif>
  <div class="controls">
    <div class="ctl"><span>Cycle</span>
      <div class="seg" data-seg="profile"><button aria-pressed="true" data-v="74">#74</button><button aria-pressed="false" data-v="60">#60</button><button aria-pressed="false" data-v="62">#62</button></div>
    </div>
    <div class="ctl"><span>Coolant</span>
      <div class="seg" data-seg="coolant">
        <button aria-pressed="false" data-v="-20">−20</button><button aria-pressed="false" data-v="-10">−10</button><button aria-pressed="true" data-v="0">±0</button><button aria-pressed="false" data-v="10">+10</button><button aria-pressed="false" data-v="20">+20 °C</button>
      </div>
    </div>
    <div class="ctl"><span>Load</span>
      <div class="seg" data-seg="current">
        <button aria-pressed="false" data-v="0.8">80%</button><button aria-pressed="false" data-v="0.9">90</button><button aria-pressed="true" data-v="1.0">100</button><button aria-pressed="false" data-v="1.1">110</button><button aria-pressed="false" data-v="1.2">120%</button>
      </div>
    </div>
  </div>
  <div class="kpis" data-kpis></div>
  <svg role="img" aria-label="Magnet temperature: recorded cycle versus modified scenario"><text x="50%" y="50%" class="tick" text-anchor="middle">loading…</text></svg>
  <div class="readout" data-readout></div>
  <p class="note" data-note></p>
</div>

<script>
  import { drawChart, loadJSON } from '@/lib/linechart';

  function init() {
    document.querySelectorAll<HTMLElement>('[data-whatif]').forEach(async (root) => {
      const d = await loadJSON('/data/emotor/what_if.json');
      const state: Record<string, string> = { profile: '74', coolant: '0', current: '1.0' };
      const key = (p: string, c: string, i: string) => `${p}|${Number(c)}|${Number(i).toFixed(1)}`; // matches Python keys, e.g. "74|10|1.0"
      const svg = root.querySelector('svg')!;
      const render = () => {
        const base = d.grid[key(state.profile, '0', '1.0')];
        const s = d.grid[key(state.profile, state.coolant, state.current)];
        const delta = (a: number, b: number) => `${a - b >= 0 ? '+' : ''}${(a - b).toFixed(1)} K`;
        root.querySelector<HTMLElement>('[data-kpis]')!.innerHTML = [
          [`${s.pm_peak.toFixed(1)} °C`, `magnet peak (${delta(s.pm_peak, base.pm_peak)})`, s.pm_peak > base.pm_peak + 0.05 ? 'up' : s.pm_peak < base.pm_peak - 0.05 ? 'good' : ''],
          [`${s.pm_mean.toFixed(1)} °C`, `magnet mean (${delta(s.pm_mean, base.pm_mean)})`, ''],
          [`${s.sw_peak.toFixed(1)} °C`, `winding peak (${delta(s.sw_peak, base.sw_peak)})`, ''],
          [`${s.min_above_100.toFixed(1)} min`, 'magnet above 100 °C', s.min_above_100 > 0 ? 'up' : 'good'],
        ].map(([v, l, cls]) => `<div class="kpi"><b class="${cls}">${v}</b><span>${l}</span></div>`).join('');
        drawChart(svg, {
          x: d.minutes[state.profile], xLabel: 'min', yUnit: ' °C', hline: { y: 100, label: '100 °C' },
          series: [
            { y: base.pm, label: 'as recorded', className: 'base' },
            { y: s.pm, label: 'scenario', className: 'est' },
          ],
        }, root.querySelector<HTMLElement>('[data-readout]')!);
        const note = root.querySelector<HTMLElement>('[data-note]')!;
        note.className = s.extrapolation ? 'note warn' : 'note';
        note.textContent = s.extrapolation
          ? 'Outside the recorded operating range: this is an extrapolation, not a validated estimate.'
          : 'Model estimate, not a measurement. Scaling currents does not re-solve the motor control, so voltages and speed are unchanged.';
      };
      root.querySelectorAll<HTMLElement>('[data-seg]').forEach((seg) =>
        seg.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
          state[seg.dataset.seg!] = b.dataset.v!;
          seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          render();
        })));
      render();
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
