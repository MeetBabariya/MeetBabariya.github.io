---
// Source for /og.png. Rendered once, screenshotted at 1200×630, never linked.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';
import AgentScores from '@/components/figures/AgentScores.astro';
---

<!doctype html>
<html lang="en" data-theme="dark" data-lens="ai">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG</title>
  </head>
  <body>
    <div class="og is-in">
      <div class="l">
        <p class="label">AI Engineer × Quant · Stuttgart</p>
        <h1 class="display">Meet<br />Babariya</h1>
        <p class="sub">ML Benchmark Engineer at Datacurve (YC) · ex-options trader · Kaggle top 1%</p>
      </div>
      <div class="r"><AgentScores /></div>
    </div>
  </body>
</html>

<style>
  body { width: 1200px; height: 630px; overflow: hidden; }
  .og { width: 1200px; height: 630px; padding: 64px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; border-bottom: 6px solid var(--accent); }
  .display { font-size: 112px; margin: 24px 0 28px; }
  .sub { font-size: 21px; color: var(--fg-2); letter-spacing: -0.01em; line-height: 1.4; }
  .r { border: 1px solid var(--rule); border-radius: 14px; padding: 16px; background: var(--bg-raised); }
</style>
